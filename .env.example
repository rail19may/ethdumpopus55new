# HTTP(S) endpoint Ethereum mainnet (Alchemy / Infura / QuickNode / свой узел).
# Для реплея старых блоков нужен архивный узел (eth_call на исторических блоках).
RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# WebSocket endpoint — нужен только при rpc.block_source: websocket
RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Telegram: токен от @BotFather и id чата/канала (бот должен быть добавлен в чат)
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=-1001234567890
